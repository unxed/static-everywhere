#!/bin/sh
# zig-c++ — see zig-cc for why this wrapper exists at all.
set -eu

# Keep Meson's linker probes compatible with Zig 0.13. See zig-cc for why
# these flag-only diagnostics must report LLD without changing real links.
_onebin_linker_probe=0
_onebin_linker_input=0
for _onebin_arg in "$@"; do
    case "$_onebin_arg" in
        -Wl,--version|-Wl,-v) _onebin_linker_probe=1 ;;
        *.c|*.cc|*.cpp|*.cxx|*.o|*.a|*.so|*.s|*.S) _onebin_linker_input=1 ;;
    esac
done
if [ "$_onebin_linker_probe" = 1 ] && [ "$_onebin_linker_input" = 0 ]; then
    printf 'LLD\n'
    exit 0
fi

if ! command -v zig >/dev/null 2>&1; then
    echo "zig-c++: 'zig' not found on PATH. Install it: https://ziglang.org/download/" >&2
    exit 127
fi

# Meson identifies the linker from the first line printed for -Wl,--version.
# Zig's default linker prints "zig ld 0.13.0", which is truthful but not one
# of Meson's recognised GNU/LLD signatures. Translate only this detection
# probe to the equivalent LLD signature; ordinary compiler calls remain
# untouched, including their output and exit status.
_onebin_linker_probe=0
for _onebin_arg in "$@"; do
    if [ "$_onebin_arg" = '-Wl,--version' ]; then
        _onebin_linker_probe=1
    fi
done
if [ "$_onebin_linker_probe" = 1 ]; then
    _onebin_has_output=0
    for _onebin_arg in "$@"; do
        case "$_onebin_arg" in
            -o|--output=*) _onebin_has_output=1 ;;
        esac
    done
    set +e
    if [ "$_onebin_has_output" = 0 ]; then
        # Meson's probe has no input or output. Without this, Zig creates
        # its default a.out in the current directory just to print the
        # linker version.
        _onebin_linker_output=$(zig c++ "$@" -o /dev/null 2>&1)
    else
        _onebin_linker_output=$(zig c++ "$@" 2>&1)
    fi
    _onebin_linker_status=$?
    set -e
    if [ "$_onebin_linker_status" -eq 0 ] &&
       printf '%s\n' "$_onebin_linker_output" | grep -q '^zig ld '; then
        printf '%s\n' "$_onebin_linker_output" | sed 's/^zig ld /LLD /'
    elif [ "$_onebin_linker_status" -eq 0 ]; then
        printf '%s\n' "$_onebin_linker_output"
    else
        printf '%s\n' "$_onebin_linker_output" >&2
    fi
    exit "$_onebin_linker_status"
fi

# See zig-cc for why these filters exist: Conan's AutotoolsDeps generator adds
# -Wl,-rpath-link,<dep-lib-dir> per dependency, while f4 adds
# -Wl,--exclude-libs at its final link. Zig rejects both spellings. Dropping
# --exclude-libs is guarded on whether the link exports symbols, as measured
# in the original investigation. KDE's compiler settings also add
# -Wl,--fatal-warnings; zig 0.13 rejects this warning-policy switch, so it is
# dropped while leaving diagnostics visible.
has_export=0
for _onebin_arg in "$@"; do
    case "$_onebin_arg" in
        -rdynamic|-export-dynamic|-Wl,--export-dynamic|-Wl,-E) has_export=1 ;;
    esac
done

# See zig-cc for why: -pie and -shared are never simultaneously valid,
# and per-package Conan conf overrides didn't reliably reach every build
# system's early configure-time probes. Fixed unconditionally here
# instead.
has_shared=0
for _onebin_arg in "$@"; do
    if [ "$_onebin_arg" = "-shared" ]; then
        has_shared=1
    fi
done

# Never use `set -- $(...)` here. CMake and qmsetup pass definitions such as
# -DTOOL_DESC="QMSetup Core Utility Command, Version 1.1.1.0" as one argv
# element. A command substitution would split that element at its spaces.
# Emit shell-quoted words and evaluate only that generated, quoted argv so
# filtering preserves every argument's exact value and order.
_onebin_shell_quote() {
    case "$1" in
        ''|*[!A-Za-z0-9_./:=+,-]*)
            _onebin_quoted=$(printf '%s' "$1" | sed "s/'/'\\\\''/g")
            printf "'%s'" "$_onebin_quoted"
            ;;
        *)
            printf '%s' "$1"
            ;;
    esac
}

_onebin_emit_filtered_args() {
    for _onebin_arg in "$@"; do
        _onebin_keep=1
        case "$_onebin_arg" in
            -Wl,-rpath-link,*)
                _onebin_keep=0
                ;;
            -Wl,--fatal-warnings)
                _onebin_keep=0
                ;;
            -Wl,--exclude-libs,*|-Wl,--exclude-libs=*)
                if [ "$has_export" = 0 ]; then
                    _onebin_keep=0
                fi
                ;;
            -pie)
                if [ "$has_shared" = 1 ]; then
                    _onebin_keep=0
                fi
                ;;
        esac
        if [ "$_onebin_keep" = 1 ]; then
            printf ' '
            _onebin_shell_quote "$_onebin_arg"
        fi
    done
}

_onebin_filtered_args=$(_onebin_emit_filtered_args "$@")
eval "set --${_onebin_filtered_args}"


# See zig-cc for the full reasoning: host graphics headers need an explicit
# staging boundary. Passing a whole /usr/include to a musl compiler lets
# CMake's configure probes read glibc headers. Exact generic host include
# roots are rewritten to ONEBIN_HOST_INCLUDE_DIR when it is set, or dropped
# otherwise. The same policy is duplicated here because CMake and Meson use
# the C++ driver independently of the C driver.
_onebin_triple=""
_onebin_want_triple=0
for _onebin_arg in "$@"; do
    if [ "$_onebin_want_triple" = 1 ]; then
        _onebin_triple="$_onebin_arg"
        _onebin_want_triple=0
        continue
    fi
    case "$_onebin_arg" in
        -target|--target) _onebin_want_triple=1 ;;
        --target=*)       _onebin_triple="${_onebin_arg#--target=}" ;;
    esac
done
# x86_64-linux-gnu.2.27 -> x86_64-linux-gnu
_onebin_triple="${_onebin_triple%%.*}"

# On musl, pthread symbols are part of libc rather than a separate
# libpthread archive.  GCC's `-pthread` still has a meaningful compile-time
# effect there (it enables the thread-safe headers via `_REENTRANT`), but Zig
# 0.13 turns the same driver option into a separate pthread link request.
# That makes configure-time checks which append `-pthread` fail even though
# the exact same source links with musl libc alone.  Preserve the portable
# compile-time contract and remove the target-inappropriate link request for
# every musl invocation, not just SDL's check.
case "${_onebin_triple}" in
    *musl*)
        _onebin_rebuilt=""
        _onebin_had_pthread=0
        for _onebin_arg in "$@"; do
            if [ "$_onebin_arg" = "-pthread" ]; then
                _onebin_had_pthread=1
            else
                _onebin_rebuilt="$_onebin_rebuilt $(_onebin_shell_quote "$_onebin_arg")"
            fi
        done
        if [ "$_onebin_had_pthread" = 1 ]; then
            _onebin_rebuilt="$_onebin_rebuilt -D_REENTRANT"
            eval "set --${_onebin_rebuilt}"
        fi
        ;;
esac

# CMake's Linux shared-library rule expands <LINK_FLAGS> before its
# <CMAKE_SHARED_LIBRARY_CREATE_CXX_FLAGS> value, whose standard value is
# -shared.  Profile U puts -static in the former, so a literal argv would be
#
#   ... -static ... -shared ...
#
# Zig 0.13 honours the last driver mode and also adds its default libc to the
# MODULE.  For every musl shared link, canonicalise the whole class here:
# remove any earlier -static, suppress Zig's implicit libc plus startup
# objects, and append the final driver mode after all -shared/create flags.
# The module's libc symbols remain undefined so the exported U executable
# supplies the one process-wide musl runtime.  C++ runtime symbols cannot use
# that route reliably: Zig's libc++ archives mark parts of the ABI hidden in a
# static PIE, so `--export-dynamic` does not make those definitions visible to
# a later dlopen.  Link the C++ runtime archives into the module itself while
# keeping libc suppressed.  `zig cc` treats `-lc++` as a request for its whole
# default C++ runtime and adds a dynamic libc even with `-nolibc`; pass the
# exact target archives instead, and use the C driver for the object-only
# shared link so the final runtime set is explicit and static.
# Compile-only invocations continue to use the C++ driver below.
# This is deliberately driver-wide rather than a far2l target hack; every
# CMake SHARED/MODULE target using the musl wrapper gets the same rule.
_onebin_use_c_driver=0
case "${_onebin_triple}" in
    *musl*)
        _onebin_compile_only=0
        for _onebin_arg in "$@"; do
            case "$_onebin_arg" in
                -c|-S|-E) _onebin_compile_only=1 ;;
            esac
        done
        if [ "$has_shared" = 1 ] && [ "$_onebin_compile_only" = 0 ]; then
            # Ask the same Zig target driver which concrete archives it would
            # select for a C++ link.  The paths live in Zig's content-addressed
            # cache and are deliberately not guessed from the installation
            # layout; this also follows a future cache-layout change without
            # making the Profile U module rule target-specific.  We use
            # -###, so this is a command-line probe, not a second link.
            _onebin_runtime_probe=$(
                zig cc -### "$@" \
                    -nolibc -nostdlib -static -lc++ -lc++abi -lunwind \
                    2>&1 || true
            )
            _onebin_runtime_probe=$(printf '%s\n' "$_onebin_runtime_probe" | tr -d '"')
            _onebin_cxxabi=$(printf '%s\n' "$_onebin_runtime_probe" |
                awk '{ for (i = 1; i <= NF; i++)
                           if ($i ~ /\/libc[+][+]abi[.]a$/) { print $i; exit } }')
            _onebin_cxx=$(printf '%s\n' "$_onebin_runtime_probe" |
                awk '{ for (i = 1; i <= NF; i++)
                           if ($i ~ /\/libc[+][+][.]a$/) { print $i; exit } }')
            _onebin_unwind=$(printf '%s\n' "$_onebin_runtime_probe" |
                awk '{ for (i = 1; i <= NF; i++)
                           if ($i ~ /\/libunwind[.]a$/) { print $i; exit } }')
            if [ -z "$_onebin_cxxabi" ] || [ -z "$_onebin_cxx" ] ||
               [ -z "$_onebin_unwind" ]; then
                echo "zig-c++: cannot discover Zig's target C++ runtime archives" >&2
                printf '%s\n' "$_onebin_runtime_probe" >&2
                exit 1
            fi

            _onebin_rebuilt=""
            for _onebin_arg in "$@"; do
                case "$_onebin_arg" in
                    -static|-fstack-protector|-fstack-protector-*)
                        # CMake repeats compile-only hardening flags on its
                        # object-only link command.  The objects already
                        # contain stack protection; keeping this flag here
                        # makes Zig require libc while producing a module
                        # whose libc symbols must stay unresolved.
                        continue
                        ;;
                    -lm|-lpthread|-lrt|-lcrypt)
                        # musl folds these compatibility libraries into libc.
                        # A bare -lm makes Zig 0.13 select its cached libc.so
                        # even under -nolibc; leave the symbols unresolved so
                        # the exported U executable supplies them.
                        continue
                        ;;
                    -lc++|-lc++abi|-lunwind|\
                    -l:libc++.a|-l:libc++abi.a|-l:libunwind.a)
                        # Replace any project-provided spelling with the
                        # concrete archives discovered above.  Leaving a
                        # bare -lc++ here would re-enable Zig's implicit
                        # libc.so and break the no-DT_NEEDED module boundary.
                        continue
                        ;;
                esac
                _onebin_rebuilt="$_onebin_rebuilt $(_onebin_shell_quote "$_onebin_arg")"
            done
            # A U module must be self-contained for C++ ABI support.  These
            # archives are supplied by the same Zig target runtime as the
            # final executable; -static makes the choice independent of any
            # host libc++ installation.  libc itself is intentionally absent
            # and is resolved by SoLo against the executable's musl image.
            _onebin_rebuilt="$_onebin_rebuilt -nolibc -nostdlib -static"
            _onebin_rebuilt="$_onebin_rebuilt $(_onebin_shell_quote "$_onebin_cxxabi")"
            _onebin_rebuilt="$_onebin_rebuilt $(_onebin_shell_quote "$_onebin_cxx")"
            _onebin_rebuilt="$_onebin_rebuilt $(_onebin_shell_quote "$_onebin_unwind")"
            eval "set --${_onebin_rebuilt}"
            _onebin_use_c_driver=1
        fi
        ;;
esac

# Which libc is this build targeting? The answer decides whether the host
# fallbacks below are appropriate at all.
#
# They exist for Profile H, which links against a declared host contract:
# xcb/*, X11/* and friends live in /usr/include and pkg-config emits no
# -I for them. For Profile S and U the whole promise is zero host
# dependencies, so a host search path there cannot produce a right
# answer -- only a wrong one that compiles.
#
# far2l's Profile U build is exactly that: musl has no backtrace(), so
# utils/include/debug.h fell through to the host's glibc
# /usr/include/execinfo.h, which opens with __BEGIN_DECLS and does not
# parse outside glibc. A header the target libc does not implement was
# offered by the host, and the build died several errors later in
# cxxabi.h with the parser already derailed.
case "$_onebin_triple" in
    *musl*) _onebin_host_fallbacks=0 ;;
    *)      _onebin_host_fallbacks=1 ;;
esac

if [ "$_onebin_host_fallbacks" = 1 ]; then
    # With a staged host-include directory the fallback points there, not at
    # /usr/include: the stage carries exactly the host contract's headers, so
    # a vendored library cannot be shadowed by whatever else the host has.
    # konsole compiled against the host's ICU 74 through this fallback while
    # linking Conan's ICU 78.
    if [ -n "${ONEBIN_HOST_INCLUDE_DIR:-}" ]; then
        set -- "$@" -idirafter "$ONEBIN_HOST_INCLUDE_DIR"
    else
        set -- "$@" -idirafter /usr/include
    fi
fi

# Keep generic host libc roots out of every musl C++ invocation, including
# CMAKE_REQUIRED_INCLUDES generated by third-party configure checks. The
# staging directory contains only the caller's declared host graphics trees.
# This rewriting used to be musl-only. It now runs for any target when
# ONEBIN_HOST_INCLUDE_DIR is set: glibc targets keep host headers reachable
# on purpose (X11, xcb, GL are host-owned), which is exactly how an
# unlisted host header could shadow a vendored one there.
case "$_onebin_triple" in
    *musl*|*)
        _onebin_host_include_dir=${ONEBIN_HOST_INCLUDE_DIR:-}
        if [ -z "$_onebin_host_include_dir" ]; then
            case "$_onebin_triple" in
                *musl*) ;;
                *) _onebin_skip_rewrite=1 ;;
            esac
        fi
        if [ -n "$_onebin_host_include_dir" ] &&
           [ ! -d "$_onebin_host_include_dir" ]; then
            echo "zig-c++: ONEBIN_HOST_INCLUDE_DIR is not a directory: $_onebin_host_include_dir" >&2
            exit 1
        fi
        case "$_onebin_host_include_dir" in
            /usr/include|/usr/include/|/usr/local/include|/usr/local/include/|/usr/include/*-linux-gnu|/usr/include/*-linux-gnu/)
                echo "zig-c++: ONEBIN_HOST_INCLUDE_DIR must be a filtered staging directory: $_onebin_host_include_dir" >&2
                exit 1
                ;;
        esac
        _onebin_rebuilt=""
        _onebin_pending_include=""
        for _onebin_arg in "$@"; do
            if [ -n "$_onebin_pending_include" ]; then
                case "$_onebin_arg" in
                    /usr/include|/usr/include/|/usr/local/include|/usr/local/include/|/usr/include/*-linux-gnu|/usr/include/*-linux-gnu/)
                        if [ -n "$_onebin_host_include_dir" ]; then
                            _onebin_rebuilt="$_onebin_rebuilt $(_onebin_shell_quote "$_onebin_pending_include") $(_onebin_shell_quote "$_onebin_host_include_dir")"
                        fi
                        ;;
                    *)
                        _onebin_rebuilt="$_onebin_rebuilt $(_onebin_shell_quote "$_onebin_pending_include") $(_onebin_shell_quote "$_onebin_arg")"
                        ;;
                esac
                _onebin_pending_include=""
                continue
            fi
            case "$_onebin_arg" in
                -I|-isystem|-idirafter)
                    _onebin_pending_include="$_onebin_arg"
                    ;;
                -I/usr/include|-I/usr/include/|-I/usr/local/include|-I/usr/local/include/|-I/usr/include/*-linux-gnu|-I/usr/include/*-linux-gnu/)
                    if [ -n "$_onebin_host_include_dir" ]; then
                        _onebin_rebuilt="$_onebin_rebuilt -I $(_onebin_shell_quote "$_onebin_host_include_dir")"
                    fi
                    ;;
                -isystem/usr/include|-isystem/usr/include/|-isystem/usr/local/include|-isystem/usr/local/include/|-isystem/usr/include/*-linux-gnu|-isystem/usr/include/*-linux-gnu/)
                    if [ -n "$_onebin_host_include_dir" ]; then
                        _onebin_rebuilt="$_onebin_rebuilt -isystem $(_onebin_shell_quote "$_onebin_host_include_dir")"
                    fi
                    ;;
                -idirafter/usr/include|-idirafter/usr/include/|-idirafter/usr/local/include|-idirafter/usr/local/include/|-idirafter/usr/include/*-linux-gnu|-idirafter/usr/include/*-linux-gnu/)
                    if [ -n "$_onebin_host_include_dir" ]; then
                        _onebin_rebuilt="$_onebin_rebuilt -idirafter $(_onebin_shell_quote "$_onebin_host_include_dir")"
                    fi
                    ;;
                *)
                    _onebin_rebuilt="$_onebin_rebuilt $(_onebin_shell_quote "$_onebin_arg")"
                    ;;
            esac
        done
        if [ -n "$_onebin_pending_include" ]; then
            _onebin_rebuilt="$_onebin_rebuilt $(_onebin_shell_quote "$_onebin_pending_include")"
        fi
        if [ "${_onebin_skip_rewrite:-0}" != 1 ]; then
            eval "set --${_onebin_rebuilt}"
        fi
        ;;
esac

# Host libraries as a last-resort search path. See zig-cc for the full
# reasoning: zig cc with -target does not search the host's
# /usr/lib/<triple>, while Conan emits host-contract libraries as bare
# -l names with no -L. Appended last so Conan's own directories are
# searched first and a vendored library still beats a host copy.
if [ "$_onebin_host_fallbacks" = 1 ]; then
    if [ -n "$_onebin_triple" ] && [ -d "/usr/lib/${_onebin_triple}" ]; then
        set -- "$@" -L"/usr/lib/${_onebin_triple}"
    fi
    for _onebin_libdir in /usr/lib64 /usr/lib; do
        if [ -d "$_onebin_libdir" ]; then
            set -- "$@" -L"$_onebin_libdir"
        fi
    done
fi


# `-o -` means stdout, and zig 0.13 writes a file called "-" instead.
#
# zig produces output atomically: it writes a temporary file and renames
# it onto the -o path. Given "-" it therefore creates a literal file of
# that name in the current directory, and given /dev/stdout it renames
# over the device and the caller reads nothing. gcc and clang both write
# to standard output here.
#
# It is not a curiosity: CMake's CXX-DetectStdlib step preprocesses with
# `-o -`, so every configure through this wrapper dropped a file named
# "-" wherever it happened to run -- including, once, into this
# repository, where it was committed. Callers also silently got empty
# output where they expected a preprocessed source.
#
# So intercept it: give zig a real temporary file, then copy that to
# standard output ourselves. This works for every mode, unlike simply
# dropping the flag, which is only equivalent for -E (with -S or -c, zig
# would write foo.s or foo.o to disk instead).
# `-E` wins over `-c`, as it does in every other driver.
#
# CMake asks the compiler for its predefined macros with
# `-dM -E -c <empty file>` and captures stdout into moc_predefs.h, which
# is how moc learns the platform. gcc treats -E as dominant and prints
# the macros; zig 0.13 lets -c win, writes an object file and prints
# nothing.
#
# The result is a zero-byte moc_predefs.h, and nothing complains. moc
# then runs without __linux__, so Q_OS_LINUX is undefined, and for a
# header like solid's fstabwatcher.h -- which declares one slot under
# #ifdef Q_OS_LINUX and a different one under #else -- moc generates a
# call to the slot that was not compiled:
#
#   moc_fstabwatcher.cpp:86:21: error: no member named 'onFileChanged'
#
# Forty minutes into the build, in a file nobody wrote, about a macro
# nobody mentioned. Silent wrong output is worse than a hard failure, so
# drop -c when -E is present and let the preprocessor speak.
_onebin_has_E=0
_onebin_has_c=0
for _onebin_arg in "$@"; do
    case "$_onebin_arg" in
        -E) _onebin_has_E=1 ;;
        -c) _onebin_has_c=1 ;;
    esac
done

if [ "$_onebin_has_E" = 1 ] && [ "$_onebin_has_c" = 1 ]; then
    _onebin_rebuilt=""
    for _onebin_arg in "$@"; do
        if [ "$_onebin_arg" = "-c" ]; then
            continue
        fi
        _onebin_rebuilt="${_onebin_rebuilt} $(_onebin_shell_quote "$_onebin_arg")"
    done
    eval "set --${_onebin_rebuilt}"
fi

# `-nostdlib` and `-nodefaultlibs` are link options; drop them when only
# compiling.
#
# gcc and clang document both as affecting what is linked, and ignore
# them when the driver is not linking. zig 0.13 also removes the C++
# standard library's include path, so a translation unit compiled with
# -nostdlib cannot find <cstdio>:
#
#   vte/src/urlencode.cc:22:10: fatal error: 'cstdio' file not found
#
# vte passes -nostdlib on the vte-urlencode-cwd target, which does
# include <cstdio>, and which links fine on every other toolchain. The
# request is about the link, so it is honoured at link time and dropped
# from compile-only invocations -- detected the same way the driver
# detects it, by the presence of -c, -S or -E.
_onebin_compile_only=0
for _onebin_arg in "$@"; do
    case "$_onebin_arg" in
        -c|-S|-E) _onebin_compile_only=1 ;;
    esac
done

if [ "$_onebin_compile_only" = 1 ]; then
    _onebin_rebuilt=""
    _onebin_dropped=0
    for _onebin_arg in "$@"; do
        case "$_onebin_arg" in
            -nostdlib|-nodefaultlibs)
                _onebin_dropped=1
                continue
                ;;
        esac
        _onebin_rebuilt="${_onebin_rebuilt} $(_onebin_shell_quote "$_onebin_arg")"
    done
    if [ "$_onebin_dropped" = 1 ]; then
        eval "set --${_onebin_rebuilt}"
    fi
fi

# `-Xlinker ARG` must become `-Wl,ARG`.
#
# zig 0.13 accepts `-Wl,--whole-archive` and rejects the identical
# `-Xlinker --whole-archive` with "unsupported linker arg". The two
# spellings mean the same thing to every other driver, and CMake emits
# the -Xlinker form for whole-archive, version scripts and rpath, so a
# CMake project links fine by hand and fails through the generator.
#
# Translating is safe: -Wl, splits on commas, so an argument that itself
# contains a comma would change meaning -- those are passed through
# unchanged rather than silently corrupted.
_onebin_xlinker=0
for _onebin_arg in "$@"; do
    if [ "$_onebin_arg" = "-Xlinker" ]; then
        _onebin_xlinker=1
        break
    fi
done

if [ "$_onebin_xlinker" = 1 ]; then
    _onebin_rebuilt=""
    _onebin_want_xarg=0
    for _onebin_arg in "$@"; do
        if [ "$_onebin_want_xarg" = 1 ]; then
            _onebin_want_xarg=0
            case "$_onebin_arg" in
                *,*)
                    # A comma would be read as an argument separator by
                    # -Wl,; keep the original spelling and let the driver
                    # decide.
                    _onebin_rebuilt="${_onebin_rebuilt} $(_onebin_shell_quote "-Xlinker") $(_onebin_shell_quote "$_onebin_arg")"
                    ;;
                *)
                    _onebin_rebuilt="${_onebin_rebuilt} $(_onebin_shell_quote "-Wl,${_onebin_arg}")"
                    ;;
            esac
            continue
        fi
        if [ "$_onebin_arg" = "-Xlinker" ]; then
            _onebin_want_xarg=1
            continue
        fi
        _onebin_rebuilt="${_onebin_rebuilt} $(_onebin_shell_quote "$_onebin_arg")"
    done
    eval "set --${_onebin_rebuilt}"
fi

_onebin_stdout_out=0
_onebin_prev=""
for _onebin_arg in "$@"; do
    if [ "$_onebin_prev" = "-o" ] && [ "$_onebin_arg" = "-" ]; then
        _onebin_stdout_out=1
        break
    fi
    _onebin_prev="$_onebin_arg"
done

if [ "$_onebin_stdout_out" = 1 ]; then
    _onebin_tmp=$(mktemp) || exit 1
    _onebin_rebuilt=""
    _onebin_prev=""
    for _onebin_arg in "$@"; do
        if [ "$_onebin_prev" = "-o" ] && [ "$_onebin_arg" = "-" ]; then
            _onebin_rebuilt="${_onebin_rebuilt} $(_onebin_shell_quote "$_onebin_tmp")"
        else
            _onebin_rebuilt="${_onebin_rebuilt} $(_onebin_shell_quote "$_onebin_arg")"
        fi
        _onebin_prev="$_onebin_arg"
    done
    eval "set --${_onebin_rebuilt}"
    zig c++ "$@"
    _onebin_status=$?
    cat "$_onebin_tmp"
    rm -f "$_onebin_tmp"
    exit "$_onebin_status"
fi

if [ "$_onebin_use_c_driver" = 1 ]; then
    exec zig cc "$@"
fi
exec zig c++ "$@"
