#!/bin/sh
# zig-c++ — see zig-cc for why this wrapper exists at all.
set -eu

if ! command -v zig >/dev/null 2>&1; then
    echo "zig-c++: 'zig' not found on PATH. Install it: https://ziglang.org/download/" >&2
    exit 127
fi

# See zig-cc for why: Conan's AutotoolsDeps generator adds one
# -Wl,-rpath-link,<dep-lib-dir> per dependency regardless of whether it's
# built shared or static; this project only ever builds dependencies
# statically, so the hint is meaningless, but zig's linker driver rejects
# it outright rather than ignoring it the way a full gcc/clang would.
# shellcheck disable=SC2046
set -- $(for _onebin_arg in "$@"; do
    case "$_onebin_arg" in
        -Wl,-rpath-link,*) ;;
        *) printf '%s\n' "$_onebin_arg" ;;
    esac
done)

# See zig-cc for why: -pie and -shared are never simultaneously valid,
# and per-package Conan conf overrides didn't reliably reach every build
# system's early configure-time probes. Fixed unconditionally here
# instead.
has_shared=0
for _onebin_arg in "$@"; do
    if [ "$_onebin_arg" = "-shared" ]; then
        has_shared=1
    fi
done
if [ "$has_shared" = 1 ]; then
    # shellcheck disable=SC2046
    set -- $(for _onebin_arg in "$@"; do
        [ "$_onebin_arg" = "-pie" ] || printf '%s\n' "$_onebin_arg"
    done)
fi

exec zig c++ "$@"
