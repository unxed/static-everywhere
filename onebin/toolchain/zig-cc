#!/bin/sh
# zig-cc — CMake needs a single executable for CMAKE_C_COMPILER; "zig cc" is
# two words and CMake will not accept that. The -target triple and every
# other flag arrive as ordinary compiler flags via CMAKE_C_FLAGS_INIT in the
# toolchain files, so this wrapper carries no target-specific knowledge of
# its own — DESIGN-onebin.md §8.
set -eu

if ! command -v zig >/dev/null 2>&1; then
    echo "zig-cc: 'zig' not found on PATH. Install it: https://ziglang.org/download/" >&2
    exit 127
fi

# Found building fontconfig via Meson: meson's compiler.preprocess()
# (used for fontconfig's gperf-template preprocessing step) invokes the
# compiler with both -E (preprocess only) and a trailing -c. GCC honors
# -E regardless of a later -c; zig's bundled Clang instead honors
# whichever action flag came last on the command line, so the trailing
# -c silences -E and the "preprocessed" gperf template gets fed to the
# C *parser* instead, which fails on the file's gperf-only syntax
# ("%{", "%struct-type", "%%"). Drop a redundant -c whenever -E is also
# present, so zig cc's behavior matches GCC's and matches what the
# caller actually asked for. Safe to do with plain word-splitting here
# (no quoting of the intermediate list): every argument this project's
# builds pass through this wrapper is a flag or a path with no embedded
# whitespace.
has_e=0
for _onebin_arg in "$@"; do
    if [ "$_onebin_arg" = "-E" ]; then
        has_e=1
    fi
done
if [ "$has_e" = 1 ]; then
    # shellcheck disable=SC2046
    set -- $(for _onebin_arg in "$@"; do
        [ "$_onebin_arg" = "-c" ] || printf '%s\n' "$_onebin_arg"
    done)
fi

# Found building elfutils via autotools: Conan's AutotoolsDeps generator
# adds one -Wl,-rpath-link,<dep-lib-dir> per dependency (a linker hint
# for resolving *shared*-library dependencies transitively at link
# time), regardless of whether those dependencies are actually built
# shared or static -- this whole project only ever builds Profile
# H/S dependencies statically, so the hint is meaningless here even when
# present, but zig cc's own linker driver rejects it outright
# ("error: unsupported linker arg: -rpath-link") where a full gcc/clang
# would just accept and ignore it as a no-op for static-only links.
# Confirmed directly from elfutils' own config.log, not guessed: the
# exact failing compiler invocation is right there. Filter these out
# rather than fight Conan's generator -- there can be more than one
# (one per dependency), so filter every occurrence, not just the first.
# shellcheck disable=SC2046
set -- $(for _onebin_arg in "$@"; do
    case "$_onebin_arg" in
        -Wl,-rpath-link,*) ;;
        *) printf '%s\n' "$_onebin_arg" ;;
    esac
done)

# Found first with openssl's providers/legacy.so, then again with
# elfutils' own `checking for __thread support` configure probe (two
# unrelated packages, two different build systems -- OpenSSL's own
# Configure/Makefile vs. plain GNU autotools): whenever -shared is also
# present, this project's own global -pie (added for hardening on real
# executables) collides with it ("error: dynamic libraries cannot be
# position independent executables"). A per-package Conan conf override
# (tools.build:exelinkflags scoped to just that package) fixed this for
# openssl but, confirmed directly from elfutils' own config.log, did NOT
# take effect for elfutils' early configure-time probe -- evidently
# different build systems pull LDFLAGS from Conan's generated files at
# different points, and package-scoped conf overrides don't reliably
# reach all of them. -pie and -shared are never simultaneously valid
# for any package this project could ever build (the combination isn't
# meaningful ELF, not just inconvenient here), so fixing it here,
# unconditionally, for every future package that might hit the same
# combination, is both more reliable and simpler than chasing exactly
# which Conan generator each build system's LDFLAGS actually come from.
has_shared=0
for _onebin_arg in "$@"; do
    if [ "$_onebin_arg" = "-shared" ]; then
        has_shared=1
    fi
done
if [ "$has_shared" = 1 ]; then
    # shellcheck disable=SC2046
    set -- $(for _onebin_arg in "$@"; do
        [ "$_onebin_arg" = "-pie" ] || printf '%s\n' "$_onebin_arg"
    done)
fi


# Host headers as a last-resort search path. zig cc with an explicit
# -target uses ONLY its own bundled libc headers and does not search the
# host's /usr/include the way a native gcc/clang does. That is correct
# for libc -- it is how this project pins the glibc baseline -- but it
# also hides genuinely host-provided headers that are part of the Layer
# 1/2 host contract (xcb/*, X11/*), which pkg-config deliberately does
# NOT emit a -I for, because /usr/include is a compiler default
# everywhere else. Diagnosed from xkbcommon's own meson-log.txt:
# `pkgconf --cflags xcb-xkb` returns success with EMPTY output while
# `--libs` returns -L/usr/lib/... (Conan sets
# PKG_CONFIG_ALLOW_SYSTEM_LIBS=1 but has no cflags equivalent), so the
# compile got no -I at all and failed on 'xcb/xkb.h' file not found.
#
# -idirafter, NOT -I: it appends the directory AFTER all built-in system
# include paths, so zig's own libc headers still win for anything it
# provides and the glibc pin is untouched; only headers zig does not
# ship at all fall through to the host. Verified against real zig 0.13.0
# rather than assumed: the failure reproduces exactly without this flag,
# builds with it, `-E -H` confirms stdio.h still resolves to zig's own
# generic-glibc copy, a linked binary's highest symbol version stays at
# GLIBC_2.4, and X11/Xlib.h (which Qt will need next) resolves too.
set -- "$@" -idirafter /usr/include

exec zig cc "$@"
