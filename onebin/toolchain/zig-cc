#!/bin/sh
# zig-cc — CMake needs a single executable for CMAKE_C_COMPILER; "zig cc" is
# two words and CMake will not accept that. The -target triple and every
# other flag arrive as ordinary compiler flags via CMAKE_C_FLAGS_INIT in the
# toolchain files, so this wrapper carries no target-specific knowledge of
# its own — DESIGN-onebin.md §8.
set -eu

# Meson identifies the linker by running the compiler with -Wl,--version and,
# after seeing an LLD banner, with -Wl,-v. Zig 0.13 handles the first probe
# internally and prints "zig ld", then rejects the second diagnostic flag.
# The actual linker is LLD; expose that fact only for these flag-only probes
# so Meson can select its normal LLD argument handling. Real compile and link
# invocations still go through Zig unchanged.
_onebin_linker_probe=0
_onebin_linker_input=0
for _onebin_arg in "$@"; do
    case "$_onebin_arg" in
        -Wl,--version|-Wl,-v) _onebin_linker_probe=1 ;;
        *.c|*.cc|*.cpp|*.cxx|*.o|*.a|*.so|*.s|*.S) _onebin_linker_input=1 ;;
    esac
done
if [ "$_onebin_linker_probe" = 1 ] && [ "$_onebin_linker_input" = 0 ]; then
    printf 'LLD\n'
    exit 0
fi

if ! command -v zig >/dev/null 2>&1; then
    echo "zig-cc: 'zig' not found on PATH. Install it: https://ziglang.org/download/" >&2
    exit 127
fi

# Meson identifies the linker from the first line printed for -Wl,--version.
# Zig's default linker prints "zig ld 0.13.0", which is truthful but not one
# of Meson's recognised GNU/LLD signatures. Translate only this detection
# probe to the equivalent LLD signature; ordinary compiler calls remain
# untouched, including their output and exit status.
_onebin_linker_probe=0
for _onebin_arg in "$@"; do
    if [ "$_onebin_arg" = '-Wl,--version' ]; then
        _onebin_linker_probe=1
    fi
done
if [ "$_onebin_linker_probe" = 1 ]; then
    _onebin_has_output=0
    for _onebin_arg in "$@"; do
        case "$_onebin_arg" in
            -o|--output=*) _onebin_has_output=1 ;;
        esac
    done
    set +e
    if [ "$_onebin_has_output" = 0 ]; then
        # Meson's probe has no input or output. Without this, Zig creates
        # its default a.out in the current directory just to print the
        # linker version.
        _onebin_linker_output=$(zig cc "$@" -o /dev/null 2>&1)
    else
        _onebin_linker_output=$(zig cc "$@" 2>&1)
    fi
    _onebin_linker_status=$?
    set -e
    if [ "$_onebin_linker_status" -eq 0 ] &&
       printf '%s\n' "$_onebin_linker_output" | grep -q '^zig ld '; then
        printf '%s\n' "$_onebin_linker_output" | sed 's/^zig ld /LLD /'
    elif [ "$_onebin_linker_status" -eq 0 ]; then
        printf '%s\n' "$_onebin_linker_output"
    else
        printf '%s\n' "$_onebin_linker_output" >&2
    fi
    exit "$_onebin_linker_status"
fi

# Found building fontconfig via Meson: meson's compiler.preprocess()
# (used for fontconfig's gperf-template preprocessing step) invokes the
# compiler with both -E (preprocess only) and a trailing -c. GCC honors
# -E regardless of a later -c; zig's bundled Clang instead honors
# whichever action flag came last on the command line, so the trailing
# -c silences -E and the "preprocessed" gperf template gets fed to the
# C *parser* instead, which fails on the file's gperf-only syntax
# ("%{", "%struct-type", "%%"). Drop a redundant -c whenever -E is also
# present, so zig cc's behavior matches GCC's and matches what the caller
# actually asked for. The filter is applied below together with the other
# argument filters, where the original argv is rebuilt without losing
# whitespace.
has_e=0
for _onebin_arg in "$@"; do
    if [ "$_onebin_arg" = "-E" ]; then
        has_e=1
    fi
done

# Found at the final link of f4-qt-host, the last target in the whole
# build: zig cc's linker driver rejects -Wl,--exclude-libs outright
# ("error: unsupported linker arg: --exclude-libs") where GNU ld and lld
# both accept it. f4 adds it itself, alongside -static-libstdc++, to keep
# static libraries from re-exporting their symbols
# (qt/host/CMakeLists.txt:114).
#
# Dropping it is safe HERE, and only here, because the target is a PIE
# executable linked without -rdynamic/-export-dynamic. Measured rather
# than reasoned: linking a PIE executable against a static archive with
# and without --exclude-libs,ALL produces byte-identical .dynsym tables;
# the control, the same link with -rdynamic added, does differ (the
# archive's symbol is exported without the flag and hidden with it). So
# the flag only ever has an effect when something is exporting, and this
# guard keeps that distinction rather than assuming it: if a link ever
# does ask to export, the flag is left in place and zig's own error
# stands, loudly, instead of us silently changing what gets exported.
#
# The wider class is surveyed in tools/zig-linker-arg-survey.sh, which
# lists every linker argument zig's driver rejects. Most are NOT dropped
# here on purpose -- --wrap, --defsym, --dynamic-list, -Bsymbolic-functions
# and --unresolved-symbols all change what the link produces, and silently
# discarding any of them would trade a loud build failure for a wrong
# binary.
has_export=0
for _onebin_arg in "$@"; do
    case "$_onebin_arg" in
        -rdynamic|-export-dynamic|-Wl,--export-dynamic|-Wl,-E) has_export=1 ;;
    esac
done
# Found first with openssl's providers/legacy.so, then again with elfutils'
# own `checking for __thread support` configure probe: whenever -shared is
# also present, this project's global -pie collides with it. The filter is
# applied below, together with the other filters.
has_shared=0
for _onebin_arg in "$@"; do
    if [ "$_onebin_arg" = "-shared" ]; then
        has_shared=1
    fi
done

# Never use `set -- $(...)` here. CMake and qmsetup pass definitions such as
# -DTOOL_DESC="QMSetup Core Utility Command, Version 1.1.1.0" as one argv
# element. A command substitution would split that element at its spaces.
# Emit shell-quoted words and evaluate only that generated, quoted argv so
# filtering preserves every argument's exact value and order.
_onebin_shell_quote() {
    case "$1" in
        ''|*[!A-Za-z0-9_./:=+,-]*)
            _onebin_quoted=$(printf '%s' "$1" | sed "s/'/'\\\\''/g")
            printf "'%s'" "$_onebin_quoted"
            ;;
        *)
            printf '%s' "$1"
            ;;
    esac
}

_onebin_emit_filtered_args() {
    for _onebin_arg in "$@"; do
        _onebin_keep=1
        case "$_onebin_arg" in
            -c)
                if [ "$has_e" = 1 ]; then
                    _onebin_keep=0
                fi
                ;;
            -Wl,-rpath-link,*)
                _onebin_keep=0
                ;;
            -Wl,--exclude-libs,*|-Wl,--exclude-libs=*)
                if [ "$has_export" = 0 ]; then
                    _onebin_keep=0
                fi
                ;;
            -pie)
                if [ "$has_shared" = 1 ]; then
                    _onebin_keep=0
                fi
                ;;
        esac
        if [ "$_onebin_keep" = 1 ]; then
            printf ' '
            _onebin_shell_quote "$_onebin_arg"
        fi
    done
}

_onebin_filtered_args=$(_onebin_emit_filtered_args "$@")
eval "set --${_onebin_filtered_args}"


# Host headers as a last-resort search path. zig cc with an explicit
# -target uses ONLY its own bundled libc headers and does not search the
# host's /usr/include the way a native gcc/clang does. That is correct
# for libc -- it is how this project pins the glibc baseline -- but it
# also hides genuinely host-provided headers that are part of the Layer
# 1/2 host contract (xcb/*, X11/*), which pkg-config deliberately does
# NOT emit a -I for, because /usr/include is a compiler default
# everywhere else. Diagnosed from xkbcommon's own meson-log.txt:
# `pkgconf --cflags xcb-xkb` returns success with EMPTY output while
# `--libs` returns -L/usr/lib/... (Conan sets
# PKG_CONFIG_ALLOW_SYSTEM_LIBS=1 but has no cflags equivalent), so the
# compile got no -I at all and failed on 'xcb/xkb.h' file not found.
#
# -idirafter, NOT -I: it appends the directory AFTER all built-in system
# include paths, so zig's own libc headers still win for anything it
# provides and the glibc pin is untouched; only headers zig does not
# ship at all fall through to the host. Verified against real zig 0.13.0
# rather than assumed: the failure reproduces exactly without this flag,
# builds with it, `-E -H` confirms stdio.h still resolves to zig's own
# generic-glibc copy, a linked binary's highest symbol version stays at
# GLIBC_2.4, and X11/Xlib.h (which Qt will need next) resolves too.
_onebin_triple=""
_onebin_want_triple=0
for _onebin_arg in "$@"; do
    if [ "$_onebin_want_triple" = 1 ]; then
        _onebin_triple="$_onebin_arg"
        _onebin_want_triple=0
        continue
    fi
    case "$_onebin_arg" in
        -target|--target) _onebin_want_triple=1 ;;
        --target=*)       _onebin_triple="${_onebin_arg#--target=}" ;;
    esac
done
# x86_64-linux-gnu.2.27 -> x86_64-linux-gnu
_onebin_triple="${_onebin_triple%%.*}"

# CMake's Linux shared-library rule expands <LINK_FLAGS> before its
# <CMAKE_SHARED_LIBRARY_CREATE_C_FLAGS> value, whose standard value is
# -shared.  Profile U puts -static in the former, so a literal argv would be
#
#   ... -static ... -shared ...
#
# Zig 0.13 honours the last driver mode and also adds its default libc to the
# MODULE.  For every musl shared link, canonicalise the whole class here:
# remove any earlier -static, suppress implicit default libraries and startup
# objects, and append the final driver mode after all -shared/create flags.
# The module's libc symbols remain undefined so the exported U executable
# supplies the one process-wide libc instance.  This is deliberately
# driver-wide rather than a far2l target hack; every CMake SHARED/MODULE
# target using the musl wrapper gets the same rule.
case "${_onebin_triple}" in
    *musl*)
        _onebin_compile_only=0
        for _onebin_arg in "$@"; do
            case "$_onebin_arg" in
                -c|-S|-E) _onebin_compile_only=1 ;;
            esac
        done
        if [ "$has_shared" = 1 ] && [ "$_onebin_compile_only" = 0 ]; then
            _onebin_rebuilt=""
            for _onebin_arg in "$@"; do
                case "$_onebin_arg" in
                    -static) continue ;;
                esac
                _onebin_rebuilt="$_onebin_rebuilt $(_onebin_shell_quote "$_onebin_arg")"
            done
            _onebin_rebuilt="$_onebin_rebuilt -nostdlib -static"
            eval "set --${_onebin_rebuilt}"
        fi
        ;;
esac

# Which libc is this build targeting? The answer decides whether the host
# fallbacks below are appropriate at all.
#
# They exist for Profile H, which links against a declared host contract:
# xcb/*, X11/* and friends live in /usr/include and pkg-config emits no
# -I for them. For Profile S and U the whole promise is zero host
# dependencies, so a host search path there cannot produce a right
# answer -- only a wrong one that compiles.
#
# far2l's Profile U build is exactly that: musl has no backtrace(), so
# utils/include/debug.h fell through to the host's glibc
# /usr/include/execinfo.h, which opens with __BEGIN_DECLS and does not
# parse outside glibc. A header the target libc does not implement was
# offered by the host, and the build died several errors later in
# cxxabi.h with the parser already derailed.
case "$_onebin_triple" in
    *musl*) _onebin_host_fallbacks=0 ;;
    *)      _onebin_host_fallbacks=1 ;;
esac

if [ "$_onebin_host_fallbacks" = 1 ]; then
    set -- "$@" -idirafter /usr/include
fi

# Host libraries as a last-resort search path -- the exact counterpart of
# the -idirafter above, and needed for the same reason. zig cc with an
# explicit -target searches only its own bundled library directories, not
# the host's /usr/lib/<triple> the way a native gcc/clang does. Conan
# emits host-contract libraries as bare `-l` names (cpp_info.system_libs,
# and Qt's own recorded system libraries) precisely because every other
# compiler finds them without help, so no -L accompanies them.
#
# Diagnosed from the failing link of ZoinGallery/libZoinGalleryQml.so:
# 28 -L flags on the command line, every one a Conan package directory,
# none of them the host's -- and zig listing all 56 paths it searched for
# libGL, none of which was /usr/lib/x86_64-linux-gnu:
#
#   error: unable to find dynamic system library 'GL' using strategy
#   'paths_first'. searched paths: <Conan package dirs only>
#
# Appended at the very END of the argument list, which is what makes this
# safe rather than merely convenient: the linker searches -L directories
# in order, so every Conan directory is tried first and a vendored
# library still wins over a host copy of the same name. Measured, because
# the reverse ordering fails silently rather than loudly: with the host
# path first, a link against a deliberately shadowed `-lz` resolved to
# the host library and produced a .so with the symbol simply unresolved.
# With the host path last it resolved to the vendored one. That is the
# same hazard that made Qt compile against the host's ICU headers, in its
# link-time form.
#
# The triple comes from the caller's own -target rather than being
# hardcoded, so this wrapper keeps carrying no target-specific knowledge
# (DESIGN-onebin.md §8). Only /usr/lib/<triple> is proven necessary here;
# lib64 and lib are included so the wrapper is not silently Debian-only,
# and every path is guarded by -d so a host without it adds nothing.
# Appending -L to a compile-only invocation was measured to produce no
# warning, so this is unconditional and stays simple.
if [ "$_onebin_host_fallbacks" = 1 ]; then
    if [ -n "$_onebin_triple" ] && [ -d "/usr/lib/${_onebin_triple}" ]; then
        set -- "$@" -L"/usr/lib/${_onebin_triple}"
    fi
    for _onebin_libdir in /usr/lib64 /usr/lib; do
        if [ -d "$_onebin_libdir" ]; then
            set -- "$@" -L"$_onebin_libdir"
        fi
    done
fi


# `-o -` means stdout, and zig 0.13 writes a file called "-" instead.
#
# zig produces output atomically: it writes a temporary file and renames
# it onto the -o path. Given "-" it therefore creates a literal file of
# that name in the current directory, and given /dev/stdout it renames
# over the device and the caller reads nothing. gcc and clang both write
# to standard output here.
#
# It is not a curiosity: CMake's CXX-DetectStdlib step preprocesses with
# `-o -`, so every configure through this wrapper dropped a file named
# "-" wherever it happened to run -- including, once, into this
# repository, where it was committed. Callers also silently got empty
# output where they expected a preprocessed source.
#
# So intercept it: give zig a real temporary file, then copy that to
# standard output ourselves. This works for every mode, unlike simply
# dropping the flag, which is only equivalent for -E (with -S or -c, zig
# would write foo.s or foo.o to disk instead).
# `-nostdlib` and `-nodefaultlibs` are link options; drop them when only
# compiling.
#
# gcc and clang document both as affecting what is linked, and ignore
# them when the driver is not linking. zig 0.13 also removes the C++
# standard library's include path, so a translation unit compiled with
# -nostdlib cannot find <cstdio>:
#
#   vte/src/urlencode.cc:22:10: fatal error: 'cstdio' file not found
#
# vte passes -nostdlib on the vte-urlencode-cwd target, which does
# include <cstdio>, and which links fine on every other toolchain. The
# request is about the link, so it is honoured at link time and dropped
# from compile-only invocations -- detected the same way the driver
# detects it, by the presence of -c, -S or -E.
_onebin_compile_only=0
for _onebin_arg in "$@"; do
    case "$_onebin_arg" in
        -c|-S|-E) _onebin_compile_only=1 ;;
    esac
done

if [ "$_onebin_compile_only" = 1 ]; then
    _onebin_rebuilt=""
    _onebin_dropped=0
    for _onebin_arg in "$@"; do
        case "$_onebin_arg" in
            -nostdlib|-nodefaultlibs)
                _onebin_dropped=1
                continue
                ;;
        esac
        _onebin_rebuilt="${_onebin_rebuilt} $(_onebin_shell_quote "$_onebin_arg")"
    done
    if [ "$_onebin_dropped" = 1 ]; then
        eval "set --${_onebin_rebuilt}"
    fi
fi

# `-Xlinker ARG` must become `-Wl,ARG`.
#
# zig 0.13 accepts `-Wl,--whole-archive` and rejects the identical
# `-Xlinker --whole-archive` with "unsupported linker arg". The two
# spellings mean the same thing to every other driver, and CMake emits
# the -Xlinker form for whole-archive, version scripts and rpath, so a
# CMake project links fine by hand and fails through the generator.
#
# Translating is safe: -Wl, splits on commas, so an argument that itself
# contains a comma would change meaning -- those are passed through
# unchanged rather than silently corrupted.
_onebin_xlinker=0
for _onebin_arg in "$@"; do
    if [ "$_onebin_arg" = "-Xlinker" ]; then
        _onebin_xlinker=1
        break
    fi
done

if [ "$_onebin_xlinker" = 1 ]; then
    _onebin_rebuilt=""
    _onebin_want_xarg=0
    for _onebin_arg in "$@"; do
        if [ "$_onebin_want_xarg" = 1 ]; then
            _onebin_want_xarg=0
            case "$_onebin_arg" in
                *,*)
                    # A comma would be read as an argument separator by
                    # -Wl,; keep the original spelling and let the driver
                    # decide.
                    _onebin_rebuilt="${_onebin_rebuilt} $(_onebin_shell_quote "-Xlinker") $(_onebin_shell_quote "$_onebin_arg")"
                    ;;
                *)
                    _onebin_rebuilt="${_onebin_rebuilt} $(_onebin_shell_quote "-Wl,${_onebin_arg}")"
                    ;;
            esac
            continue
        fi
        if [ "$_onebin_arg" = "-Xlinker" ]; then
            _onebin_want_xarg=1
            continue
        fi
        _onebin_rebuilt="${_onebin_rebuilt} $(_onebin_shell_quote "$_onebin_arg")"
    done
    eval "set --${_onebin_rebuilt}"
fi

_onebin_stdout_out=0
_onebin_prev=""
for _onebin_arg in "$@"; do
    if [ "$_onebin_prev" = "-o" ] && [ "$_onebin_arg" = "-" ]; then
        _onebin_stdout_out=1
        break
    fi
    _onebin_prev="$_onebin_arg"
done

if [ "$_onebin_stdout_out" = 1 ]; then
    _onebin_tmp=$(mktemp) || exit 1
    _onebin_rebuilt=""
    _onebin_prev=""
    for _onebin_arg in "$@"; do
        if [ "$_onebin_prev" = "-o" ] && [ "$_onebin_arg" = "-" ]; then
            _onebin_rebuilt="${_onebin_rebuilt} $(_onebin_shell_quote "$_onebin_tmp")"
        else
            _onebin_rebuilt="${_onebin_rebuilt} $(_onebin_shell_quote "$_onebin_arg")"
        fi
        _onebin_prev="$_onebin_arg"
    done
    eval "set --${_onebin_rebuilt}"
    zig cc "$@"
    _onebin_status=$?
    cat "$_onebin_tmp"
    rm -f "$_onebin_tmp"
    exit "$_onebin_status"
fi

exec zig cc "$@"
