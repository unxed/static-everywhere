diff --git a/third_party/ZoinGallery/qml/GalleryThumbnailShaderLayer.qml b/third_party/ZoinGallery/qml/GalleryThumbnailShaderLayer.qml
index 1fe9ee9..02e50f8 100644
--- a/third_party/ZoinGallery/qml/GalleryThumbnailShaderLayer.qml
+++ b/third_party/ZoinGallery/qml/GalleryThumbnailShaderLayer.qml
@@ -65,4 +65,24 @@ Item {
         fragmentShader: "qrc:/ZoinGallery/resources/shader.frag.qsb"
         visible: layer.imageSource.toString() !== ""
     }
+
+    // Qt Quick's software scenegraph does not paint this custom shader. Keep
+    // the shader path for hardware renderers, but draw the provider image
+    // through the built-in raster Image node when software rendering is used.
+    Image {
+        id: softwareThumbnailImage
+        objectName: layer.activePresentation
+                    ? "gallerySoftwareThumbnailImage-" + layer.entry.viewIndex : ""
+        x: thumbnailShader.x
+        y: thumbnailShader.y
+        width: thumbnailShader.width
+        height: thumbnailShader.height
+        source: sourceImage.source
+        fillMode: sourceImage.fillMode
+        asynchronous: false
+        cache: false
+        mipmap: false
+        visible: GraphicsInfo.api === GraphicsInfo.Software
+                 && layer.imageSource.toString() !== ""
+    }
 }
