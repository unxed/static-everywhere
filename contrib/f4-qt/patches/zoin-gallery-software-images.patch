diff --git a/third_party/ZoinGallery/qml/ViewerImageLayer.qml b/third_party/ZoinGallery/qml/ViewerImageLayer.qml
index e5713a8..8c87fe4 100644
--- a/third_party/ZoinGallery/qml/ViewerImageLayer.qml
+++ b/third_party/ZoinGallery/qml/ViewerImageLayer.qml
@@ -286,5 +286,23 @@ Item {
                          && !root.viewport.zoomFitView
             }
         }
+
+        // ViewerResample is a custom fragment shader and has no raster
+        // scenegraph implementation. Preserve the image-viewing contract on
+        // software-only systems with a direct Image fallback; hardware
+        // renderers retain the resampling path above.
+        Image {
+            id: softwareImage
+            objectName: "galleryViewerSoftwareImage"
+            anchors.fill: parent
+            source: imageShader.imageSource
+                    ? imageShader.imageSource.source : root.source
+            fillMode: Image.PreserveAspectFit
+            asynchronous: false
+            cache: false
+            mipmap: false
+            visible: GraphicsInfo.api === GraphicsInfo.Software
+                     && root.viewport.imageTextureReady
+        }
     }
 }
