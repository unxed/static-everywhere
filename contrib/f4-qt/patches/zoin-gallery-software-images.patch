diff --git a/third_party/ZoinGallery/qml/SphericViewer.qml b/third_party/ZoinGallery/qml/SphericViewer.qml
--- a/third_party/ZoinGallery/qml/SphericViewer.qml
+++ b/third_party/ZoinGallery/qml/SphericViewer.qml
@@ -67,0 +68,16 @@ Item {
+    // The spherical projection is a custom fragment shader and therefore has
+    // no raster-scenegraph implementation. Keep panorama files visible on
+    // software-only systems as a fitted equirectangular image; hardware
+    // renderers retain the interactive spherical projection above.
+    Image {
+        id: softwarePanoramaImage
+        objectName: "gallerySoftwarePanoramaImage"
+        anchors.fill: parent
+        source: flickableArea.source
+        fillMode: Image.PreserveAspectFit
+        asynchronous: false
+        cache: false
+        mipmap: false
+        visible: GraphicsInfo.api === GraphicsInfo.Software
+                 && flickableArea.source != ""
+    }
