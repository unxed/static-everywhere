 #endif /* ENABLE_DEBUG */
 
+static char*
+get_portable_install_dir(char const* install_dir)
+{
+  auto const root = g_getenv("GNOME_TERMINAL_PORTABLE_ROOT");
+  if (!root || !root[0] || !g_path_is_absolute(root) ||
+      !g_path_is_absolute(install_dir))
+    return nullptr;
+
+  while (*install_dir == '/')
+    ++install_dir;
+
+  return g_build_filename(root, install_dir, nullptr);
+}
+
+char*
+terminal_client_get_install_dir(char const* install_dir)
+{
+  gs_free auto path = get_portable_install_dir(install_dir);
+  if (path)
+    return g_steal_pointer(&path);
+
+  return g_strdup(install_dir);
+}
+
