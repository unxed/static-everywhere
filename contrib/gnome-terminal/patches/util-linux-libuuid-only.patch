diff --git a/meson.build b/meson.build
index baca755..0292df4 100644
--- a/meson.build
+++ b/meson.build
@@ -885,6 +885,18 @@ bashcompletionslinks = {}
 
 subdir('include')
 subdir('lib')
+
+# static-everywhere: build nothing but libuuid when asked.
+#
+# subdir_done() stops interpreting this file here, which skips every
+# other library, every program, and all the man-page and completion
+# install rules below. libuuid/meson.build generates uuid.pc itself, so
+# the archive and its pkg-config file both survive the cut.
+if get_option('libuuid-only')
+  subdir('libuuid')
+  subdir_done()
+endif
+
 subdir('libblkid')
 subdir('libmount')
 subdir('libsmartcols')
