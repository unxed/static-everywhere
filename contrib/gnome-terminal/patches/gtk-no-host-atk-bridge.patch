diff --git a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -442,7 +442,7 @@ iso_codes_dep  = dependency('iso-codes', required: false)
 
 fontconfig_dep = [] # only used in x11 backend
