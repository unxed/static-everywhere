config-version: 2

global:
  branch-group: latest-kf6
  include-dependencies: true

  # Projects excluded from the graph, with the reason each is safe to drop.
  #
  # kdoctools: builds meinproc6, a host tool that generates DocBook
  # handbooks -- and that tool, built with this toolchain, segfaults
  # (code 139) on the first document kio hands it. Every consumer in the
  # graph treats KF6DocTools as optional (find_package without REQUIRED,
  # gated by if(KF6DocTools_FOUND)); read from the CMakeLists of konsole,
  # kio, kservice, kwallet and the rest before deciding, not assumed. A
  # terminal emulator ships no handbook it cannot open, so removing the
  # tool removes the whole class -- every module's handbook step, not
  # just kio's -- rather than one segfault.
  #
  # kirigami: a QML UI framework that knewstuff lists as TYPE RUNTIME,
  # needed only by its QML components at run time, never for the build.
  # Excluding it keeps a large Quick-based tree out of a graph whose
  # consumer is a Widgets application.
  # A YAML list, not a space-separated string: kde-builder's
  # options_base.verify_option_value_type singles out ignore-projects and
  # rejects a str outright ("has invalid value type"). It is the only
  # option with that check, which is why the surrounding ones are scalars.
  ignore-projects:
    - kdoctools
    - kirigami
  source-dir: "@KDE_SOURCE_DIR@"
  build-dir: "@KDE_BUILD_DIR@"
  install-dir: "@KDE_INSTALL_DIR@"
  log-dir: "@KDE_LOG_DIR@"
  persistent-data-file: "@KDE_STATE_DIR@/persistent.json"
  cmake-generator: Ninja
  stop-on-failure: true
  run-tests: false
  check-self-updates: false
  compile-commands-export: false
  compile-commands-linking: false
  num-cores: "@KDE_JOBS@"
  cmake-options: >
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_TOOLCHAIN_FILE=@CONAN_TOOLCHAIN@
    -DCMAKE_C_COMPILER=@ZIGCC@
    -DCMAKE_CXX_COMPILER=@ZIGCXX@
    -DCMAKE_PREFIX_PATH=@CMAKE_PREFIX_PATH@
    -DCMAKE_PROJECT_INCLUDE=@PROJECT_INCLUDE@
    -DBUILD_SHARED_LIBS=OFF
    -DCMAKE_SKIP_RPATH=ON
    -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=OFF
    -DCMAKE_FIND_PACKAGE_PREFER_CONFIG=ON
    -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF
    -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF
    # X11, XCB and the OpenGL/EGL ABI are deliberately host-owned. KDE's
    # KGuiAddons and KWindowSystem use CMake's FindX11/FindXCB MODULEs, so
    # their development headers and libraries must remain discoverable in
    # /usr. Conan prefixes are still first in CMAKE_PREFIX_PATH and the
    # top-level hook rejects any host Qt/KF6 target that could be selected.
    # Explicitly clear a value left in a reused CMake cache as well.
    -DCMAKE_IGNORE_PREFIX_PATH=
    -DKDE_INSTALL_USE_QT_SYS_PATHS=OFF
    # Pin KDE_INSTALL_LIBDIR for every module, so where a framework's
    # CMake files land does not depend on what happened to be included
    # before KDEInstallDirs.
    #
    # ECM defaults this to lib/${CMAKE_LIBRARY_ARCHITECTURE} on a Debian
    # host (lib/x86_64-linux-gnu on the runner) -- unless CMAKE_INSTALL_LIBDIR
    # is already set, in which case ECM takes that and warns. The project
    # hook's find_package(KF6Notifications CONFIG) pulls in Qt6, which
    # includes GNUInstallDirs, which sets CMAKE_INSTALL_LIBDIR=lib before
    # kjobwidgets' own CMakeLists reaches KDEInstallDirs. So kjobwidgets
    # installed to lib/cmake while knotifications and kcoreaddons went to
    # lib/x86_64-linux-gnu/cmake, and find_package(KF6JobWidgets) could not
    # see its own dependency's config:
    #
    #   The link interface of target "KF6::JobWidgets" contains
    #     KF6::Notifications but the target was not found.
    #
    # An explicit value ends the dependence on include order: every module
    # installs to the same place regardless of what pulled in
    # GNUInstallDirs first.
    -DKDE_INSTALL_LIBDIR=lib
    # Declare /usr/include implicit, for every module. CMake cannot
    # introspect zig-c++ and records CMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES
    # as empty, so it stops filtering /usr/include out of target include
    # lists and emits it explicitly -- and FindX11 hands every X11
    # consumer X11_INCLUDE_DIR=/usr/include, which then lands as
    # `-isystem /usr/include` AHEAD of the Conan include paths. konsole
    # compiled TerminalDisplay.cpp against the host's ICU 74 headers and
    # linked Conan's ICU 78 archives: undefined ubidi_*_74. The Conan Qt
    # graph already carries this variable (qt-host/conanfile.py); the
    # KF6 modules and konsole are configured by kde-builder and did not.
    # Same fix as f4-qt's, and truthful: the zig wrappers append
    # `-idirafter /usr/include`, so it genuinely is a lowest-priority
    # implicit path for this compiler.
    -DCMAKE_C_IMPLICIT_INCLUDE_DIRECTORIES=/usr/include
    -DCMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES=/usr/include

    -DONEBIN_GLIBC_BASELINE=2.27
    -DBUILD_TESTING=OFF
    -DKCONFIG_USE_QML=OFF
    # ki18n's src/i18n-qml compiles against Qt6::Qml, and Qt's own
    # klocalizedqmlcontext.h opens with #include <qqmlintegration.h>.
    # That header is not in include/QtQml: it belongs to the separate
    # QtQmlIntegration module. Upstream Qt propagates that include
    # directory through the Qt6::Qml target; this Conan package does not,
    # so the compile line lists include/QtQml, include/QtCore and friends
    # but never include/QtQmlIntegration, and the build dies with
    # "'qqmlintegration.h' file not found".
    #
    # Note what does NOT fix it: -DBUILD_WITH_QML=OFF is already set
    # above and has no effect here, because ki18n gates the subdirectory
    # on `if (TARGET Qt6::Qml)` rather than on that option, and Conan's
    # Qt6 config defines every component target regardless.
    #
    # CMAKE_CXX_STANDARD_INCLUDE_DIRECTORIES adds the directory to every
    # compile without touching CMAKE_CXX_FLAGS, so the toolchain file's
    # own flags are left alone. Verified with a real cmake configure:
    # without it the include fails, with it the build completes.
    #
    # The real defect is in the Qt package and is filed in
    # contrib/konsole/UPSTREAM.md; this unblocks the build meanwhile.
    -DCMAKE_CXX_STANDARD_INCLUDE_DIRECTORIES=@QT_PACKAGE_ROOT@/include/QtQmlIntegration
    -DBUILD_WITH_QML=OFF
    -DKCOREADDONS_USE_QML=OFF
    -DKICONTHEMES_USE_QTQUICK=OFF
    -DKWINDOWSYSTEM_QML=OFF
    -DKWINDOWSYSTEM_X11=ON
    -DKWINDOWSYSTEM_WAYLAND=OFF
    -DWITH_WAYLAND=OFF
    -DUSE_DBUS=OFF
    -DBUILD_DESIGNERPLUGIN=OFF
    -DWITH_TEXT_TO_SPEECH=OFF
    -DSONNET_USE_QML=OFF
    -DWITH_BZIP2=ON
    -DWITH_LIBLZMA=ON
    -DWITH_OPENSSL=OFF
    -DWITH_LIBZSTD=OFF
    -DUDEV_DISABLED=ON
    -DATTICA_STATIC_BUILD=ON
    # These optional framework integrations are not part of Konsole's
    # application graph. Do not let an installed runner library silently
    # turn them into host-linked targets.
    -DCMAKE_DISABLE_FIND_PACKAGE_ACL=ON
    -DCMAKE_DISABLE_FIND_PACKAGE_OpenMP=ON
    -DCMAKE_DISABLE_FIND_PACKAGE_UTEMPTER=ON
    -DCMAKE_DISABLE_FIND_PACKAGE_UDev=ON
    # KWallet's default daemon targets are not part of the Konsole graph.
    # BUILD_KWALLETD additionally requires libsecret-1 (and its GLib graph),
    # while the backend requires LibGcrypt. Keep the KF6Wallet API, but do
    # not build unused runtime services and their host-oriented dependencies.
    -DBUILD_KSECRETD=OFF
    -DBUILD_KWALLETD=OFF
    -DBUILD_KWALLET_QUERY=OFF
    -DWITH_KAPSULE=OFF
    -DWITH_LIBSSH=OFF
    -DWITH_X11=ON
    -DENABLE_PLUGIN_SSHMANAGER=OFF
    -DENABLE_PLUGIN_QUICKCOMMANDS=OFF
    -DKONSOLE_BUILD_UNI2CHARACTERWIDTH=OFF
    -DINSTALL_ICONS=ON


  # Run each module's install through a wrapper that reconciles the CMake
  # configs it just installed against the targets they export. kio consumes
  # KF6JobWidgets, whose installed config omits its own KF6Notifications
  # find_dependency (an upstream template bug), and kio configures mid-chain,
  # so there is no "after the build" point to fix it. make-install-prefix runs
  # right after each install and before the next module configures -- the only
  # moment that works. The wrapper installs first, then reconciles; the tool
  # and prefix reach it through SE_RECONCILE_* in the environment.
  make-install-prefix: "@INSTALL_PREFIX_CMD@"
override konsole:
  revision: "@KONSOLE_REF@"

# qca defaults to its legacy Qt5 build. The KDE dependency graph consumes its
# Qt6 package, and qca's CMakeLists.txt requires Qt6 Core5Compat even when its
# optional tests and command-line tools are not part of the application build.
override qca:
  cmake-options: >
    -DBUILD_WITH_QT6=ON
    -DBUILD_TESTS=OFF
    -DBUILD_TOOLS=OFF
    -DBUILD_PLUGINS=none
