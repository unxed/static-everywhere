config-version: 2

global:
  branch-group: latest-kf6
  include-dependencies: true

  # Projects excluded from the graph, with the reason each is safe to drop.
  #
  # kdoctools: builds meinproc6, a host tool that generates DocBook
  # handbooks -- and that tool, built with this toolchain, segfaults
  # (code 139) on the first document kio hands it. Every consumer in the
  # graph treats KF6DocTools as optional (find_package without REQUIRED,
  # gated by if(KF6DocTools_FOUND)); read from the CMakeLists of konsole,
  # kio, kservice, kwallet and the rest before deciding, not assumed. A
  # terminal emulator ships no handbook it cannot open, so removing the
  # tool removes the whole class -- every module's handbook step, not
  # just kio's -- rather than one segfault.
  #
  # kirigami: a QML UI framework that knewstuff lists as TYPE RUNTIME,
  # needed only by its QML components at run time, never for the build.
  # Excluding it keeps a large Quick-based tree out of a graph whose
  # consumer is a Widgets application.
  # A YAML list, not a space-separated string: kde-builder's
  # options_base.verify_option_value_type singles out ignore-projects and
  # rejects a str outright ("has invalid value type"). It is the only
  # option with that check, which is why the surrounding ones are scalars.
  ignore-projects:
    - kdoctools
    - kirigami
  source-dir: "@KDE_SOURCE_DIR@"
  build-dir: "@KDE_BUILD_DIR@"
  install-dir: "@KDE_INSTALL_DIR@"
  log-dir: "@KDE_LOG_DIR@"
  persistent-data-file: "@KDE_STATE_DIR@/persistent.json"
  cmake-generator: Ninja
  stop-on-failure: true
  run-tests: false
  check-self-updates: false
  compile-commands-export: false
  compile-commands-linking: false
  num-cores: "@KDE_JOBS@"

  # `cmake-options` is a YAML folded scalar. Keep rationale outside the
  # scalar: an indented `#` line becomes literal option text, which is then
  # passed to kde-builder's shlex.split. An apostrophe in such text (for
  # example, `KDE's`) makes the whole build fail before the first configure.
  #
  # X11, XCB and the OpenGL/EGL ABI are deliberately host-owned. Conan
  # prefixes remain first in CMAKE_PREFIX_PATH, while the empty ignore prefix
  # option keeps the runner's FindX11/FindXCB modules discoverable.
  # KDE_INSTALL_LIBDIR is pinned so every framework installs its CONFIG files
  # under the same lib/cmake tree, independently of include order.
  # /usr/include is declared implicit for Zig-built KDE modules, keeping host
  # X11 headers lower priority than the Conan headers and avoiding host/Conan
  # ICU mismatches.
  # ki18n needs QtQmlIntegration's header even when its QML option is disabled;
  # this is a package workaround documented in contrib/konsole/UPSTREAM.md.
  # The remaining switches keep the graph Widgets/X11-only and disable unused
  # services, optional integrations and host-oriented runtime dependencies.
  cmake-options: >
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_TOOLCHAIN_FILE=@CONAN_TOOLCHAIN@
    -DCMAKE_C_COMPILER=@ZIGCC@
    -DCMAKE_CXX_COMPILER=@ZIGCXX@
    -DCMAKE_PREFIX_PATH=@CMAKE_PREFIX_PATH@
    -DCMAKE_PROJECT_INCLUDE=@PROJECT_INCLUDE@
    -DBUILD_SHARED_LIBS=OFF
    -DCMAKE_SKIP_RPATH=ON
    -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=OFF
    -DCMAKE_FIND_PACKAGE_PREFER_CONFIG=ON
    -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF
    -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF
    -DCMAKE_IGNORE_PREFIX_PATH=
    -DKDE_INSTALL_USE_QT_SYS_PATHS=OFF
    -DKDE_INSTALL_LIBDIR=lib
    -DCMAKE_C_IMPLICIT_INCLUDE_DIRECTORIES=/usr/include
    -DCMAKE_CXX_IMPLICIT_INCLUDE_DIRECTORIES=/usr/include

    -DONEBIN_GLIBC_BASELINE=2.27
    -DBUILD_TESTING=OFF
    -DKCONFIG_USE_QML=OFF
    -DCMAKE_CXX_STANDARD_INCLUDE_DIRECTORIES=@QT_PACKAGE_ROOT@/include/QtQmlIntegration
    -DBUILD_WITH_QML=OFF
    -DKCOREADDONS_USE_QML=OFF
    -DKICONTHEMES_USE_QTQUICK=OFF
    -DKWINDOWSYSTEM_QML=OFF
    -DKWINDOWSYSTEM_X11=ON
    -DKWINDOWSYSTEM_WAYLAND=OFF
    -DWITH_WAYLAND=OFF
    -DUSE_DBUS=OFF
    -DBUILD_DESIGNERPLUGIN=OFF
    -DWITH_TEXT_TO_SPEECH=OFF
    -DSONNET_USE_QML=OFF
    -DWITH_BZIP2=ON
    -DWITH_LIBLZMA=ON
    -DWITH_OPENSSL=OFF
    -DWITH_LIBZSTD=OFF
    -DUDEV_DISABLED=ON
    -DATTICA_STATIC_BUILD=ON
    -DCMAKE_DISABLE_FIND_PACKAGE_ACL=ON
    -DCMAKE_DISABLE_FIND_PACKAGE_OpenMP=ON
    -DCMAKE_DISABLE_FIND_PACKAGE_UTEMPTER=ON
    -DCMAKE_DISABLE_FIND_PACKAGE_UDev=ON
    -DBUILD_KSECRETD=OFF
    -DBUILD_KWALLETD=OFF
    -DBUILD_KWALLET_QUERY=OFF
    -DWITH_KAPSULE=OFF
    -DWITH_LIBSSH=OFF
    -DWITH_X11=ON
    -DENABLE_PLUGIN_SSHMANAGER=OFF
    -DENABLE_PLUGIN_QUICKCOMMANDS=OFF
    -DKONSOLE_BUILD_UNI2CHARACTERWIDTH=OFF
    -DINSTALL_ICONS=ON


  # Run each module's install through a wrapper that reconciles the CMake
  # configs it just installed against the targets they export. kio consumes
  # KF6JobWidgets, whose installed config omits its own KF6Notifications
  # find_dependency (an upstream template bug), and kio configures mid-chain,
  # so there is no "after the build" point to fix it. make-install-prefix runs
  # right after each install and before the next module configures -- the only
  # moment that works. The wrapper installs first, then reconciles; the tool
  # and prefix reach it through SE_RECONCILE_* in the environment.
  make-install-prefix: "@INSTALL_PREFIX_CMD@"
override konsole:
  revision: "@KONSOLE_REF@"

# qca defaults to its legacy Qt5 build. The KDE dependency graph consumes its
# Qt6 package, and qca's CMakeLists.txt requires Qt6 Core5Compat even when its
# optional tests and command-line tools are not part of the application build.
override qca:
  cmake-options: >
    -DBUILD_WITH_QT6=ON
    -DBUILD_TESTS=OFF
    -DBUILD_TOOLS=OFF
    -DBUILD_PLUGINS=none
